# OS / editor
.DS_Store
._*
*.bak
*~
.claude/
.vscode/
.idea/

# Python cache
__pycache__/
*.pyc

# ESP-IDF build artifacts
esp-idf/build*/
esp-idf/managed_components/
esp-idf/dependencies.lock
esp-idf/sdkconfig
esp-idf/sdkconfig.old

# Browser package build artifacts
browser/node_modules/
browser/dist/
browser/.quasar/

# Written into this half when a build treats it as a buildable's web root:
# straddles.gen.ts is the generated registration dispatcher, and app-icons/ is
# a copy of every staged straddle's assets/lcd-icons/*.svg. Ours live in
# esp-idf/assets/lcd-icons/, which is where they are edited.
browser/src/boot/*.gen.ts
browser/src/app-icons/

# spangap CLI staging (regenerated by `spangap make`)
staging/

# Auto-generated artifacts (added by maintenance sweep)
*.pyo

# Generated browser/npm artifacts (regenerated each build)
**/package-lock.json

# Build artifacts (spangap-generated)
esp-idf/build/
