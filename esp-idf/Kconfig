menu "spangap: reticulous iface-lora"

config LORA_COUNT
    int "Number of LoRa radios"
    range 0 4
    default 0
    help
        How many LoRa modems this board drives. 0 means no LoRa: iface-lora
        compiles to a no-op (loraInit() returns immediately, RadioLib is
        linked out). Each radio registers with rnsd as a separate
        interface named lora/<slot> (lora/0, lora/1, ...).

        Boards set this (and the pins below) in their sdkconfig.defaults;
        a build can override with `spangap build --lora-count N` and the
        matching --loraN-* switches, or interactively via `spangap menuconfig`.

config LORA_NO_SUPE
    bool "Build without SUPE"
    default n
    help
        Leaves SUPE out entirely: no engine, no frames, no console command, no
        settings, no keys in storage, no mention of it anywhere the user can
        see. What remains is a plain LoRa interface carrying Reticulum on the
        configured channel.

        A node built this way neither speaks nor answers SUPE. Its neighbours
        are unaffected — SUPE is designed to leave non-participants unmodified
        and unaware.

# ─── shared SPI bus ───────────────────────────────────────────────────
# One SPI host carries every radio (and, on boards like the T-Deck, the
# display and SD card too). spi_helper makes bus bring-up idempotent, so
# all radios share these pins; only CS/DIO1/BUSY/RST differ per radio.

config LORA_SPI_HOST
    int "Shared SPI host (1=SPI1 2=SPI2/FSPI 3=SPI3)"
    default 2
    depends on LORA_COUNT > 0

config LORA_SCK_PIN
    int "SPI SCK pin"
    default -1
    depends on LORA_COUNT > 0

config LORA_MOSI_PIN
    int "SPI MOSI pin"
    default -1
    depends on LORA_COUNT > 0

config LORA_MISO_PIN
    int "SPI MISO pin"
    default -1
    depends on LORA_COUNT > 0

# ─── radio 0 ──────────────────────────────────────────────
config LORA0_CS_PIN
    int "Radio 0 — CS / NSS pin"
    default -1
    depends on LORA_COUNT > 0
config LORA0_DIO1_PIN
    int "Radio 0 — IRQ pin"
    default -1
    depends on LORA_COUNT > 0
    help
        The chip's interrupt line wired to this MCU GPIO: DIO1 on SX126x/
        SX128x, DIO0 on SX127x, IRQ on LR11x0/LR2021. RX-done wakes the task.
config LORA0_BUSY_PIN
    int "Radio 0 — BUSY pin (-1 if none)"
    default -1
    depends on LORA_COUNT > 0
    help
        SX126x/SX128x/LR11x0/LR2021 have a BUSY line; SX127x does not — set -1.
config LORA0_RST_PIN
    int "Radio 0 — RST pin (-1 if none)"
    default -1
    depends on LORA_COUNT > 0
config LORA0_TCXO_MV
    int "Radio 0 — TCXO control voltage in mV (0 = no TCXO / XTAL)"
    default 0
    depends on LORA_COUNT > 0
    help
        Applies to SX126x / LR11x0 / LR2021 (chip-driven TCXO). Ignored by
        SX127x (crystal only) and SX128x (hardware XTAL/TCXO).
config LORA0_DIO2_RF_SWITCH
    bool "Radio 0 — DIO2 drives the RF switch (SX126x only)"
    default n
    depends on LORA_COUNT > 0
config LORA0_RFSW_RX_PIN
    int "Radio 0 — RF-switch RX-enable GPIO (-1 if none)"
    default -1
    depends on LORA_COUNT > 0
    help
        Optional external antenna RF switch driven by two MCU GPIOs
        (Module::setRfSwitchPins). Leave both at -1 if the board has no
        switch or the chip drives it internally (e.g. SX126x DIO2 above).
config LORA0_RFSW_TX_PIN
    int "Radio 0 — RF-switch TX-enable GPIO (-1 if none)"
    default -1
    depends on LORA_COUNT > 0
config LORA_TX_POWER_MAX
    int "Antenna TX power ceiling (dBm)"
    default 22
    help
        The board's real RF capability at the antenna. 22 (the bare SX126x
        max) unless the board routes the radio through a FEM — then the board
        sets the FEM ceiling here (e.g. 27 on the Heltec V4; 35 on the
        Station G2, which declares its P1dB rather than the 36 its chip cap
        plus gain could theoretically reach) alongside the FEM declaration
        below. The TX-power
        slider's max is sized from this at build time, and femInit applies it
        as the runtime ceiling when the FEM is actually detected — or, for a
        fixed FEM (FEM_FIXED_GAIN_DB), on the declaration alone, there being
        nothing to detect.

config LORA0_FEM_PWR_PIN
    int "Radio 0 — FEM rail-enable GPIO (-1 if none)"
    default -1
    depends on LORA_COUNT > 0
    help
        External RF front-end module (PA + LNA + antenna switch) between the
        radio and the antenna, e.g. the Heltec V4's GC1109 (board rev <= 4.2)
        or KCT8103L (rev 4.3). EN is the FEM chip-enable and doubles as the
        boot-time detect sense (the KCT8103L board design pulls it up); the
        two TXSEL values name the direction pin of each candidate FEM, and
        detection picks which one is driven. -1 on EN = no detectable FEM:
        user-facing TX power then caps at the bare chip's 22 dBm instead of
        27. A front end with no pins at all is the FEM_FIXED_GAIN_DB
        declaration below, not this detect path. See lora_fem.h.
config LORA0_FEM_EN_PIN
    int "Radio 0 — FEM chip-enable / detect GPIO (-1 = no FEM)"
    default -1
    depends on LORA_COUNT > 0
config LORA0_FEM_TXSEL_A_PIN
    int "Radio 0 — FEM TX-select GPIO, GC1109-style part (-1 if none)"
    default -1
    depends on LORA_COUNT > 0
config LORA0_FEM_TXSEL_B_PIN
    int "Radio 0 — FEM TX-select GPIO, KCT8103L-style part (-1 if none)"
    default -1
    depends on LORA_COUNT > 0
config LORA0_FEM_FIXED_GAIN_DB
    int "Radio 0 — fixed FEM TX gain in dB (0 = no fixed FEM)"
    default 0
    depends on LORA_COUNT > 0
    help
        A FEM that is always in the TX path and gives the firmware no control
        or detect pins — the B&Q Station G2's 35 dBm PA is the reference
        hardware: its RF switch hangs off the SX1262's own DIO2 and its rails
        come up with the board, so there is nothing to sense and nothing to
        drive. Declared, not detected: a non-zero value here says the FEM is
        there, femInit believes it, and LORA_TX_POWER_MAX above states the
        antenna ceiling exactly as it does for the detected parts. The value
        is the PA's TX gain below compression (Station G2 declares 20, the
        EU868 mid-table figure from B&Q's conduction test), which femChipDbm
        subtracts to turn the user's antenna dBm into chip drive.
        Mutually exclusive with the FEM_EN_PIN detect path — a slot declaring
        both gets the fixed FEM and an error in the boot log, since a detect
        sense on hardware that cannot answer it would read garbage.
config LORA0_FEM_MAX_CHIP_DBM
    int "Radio 0 — fixed FEM max chip drive in dBm"
    default 22
    depends on LORA_COUNT > 0
    help
        The most the fixed FEM's input tolerates from the chip, in dBm. This
        is the safety line for an always-in-path PA: the Station G2's input
        P1dB region ends at chip 16 dBm and its absolute cap is 19 — driving
        the chip's full 22 into it is out of spec however the request came
        about, so femChipDbm clamps every chip drive to this. Unread without
        FEM_FIXED_GAIN_DB above.
choice
    prompt "Radio 0 — chip"
    default LORA0_RADIO_SX1262
    depends on LORA_COUNT > 0
    help
        The LoRa chip on this slot. All RadioLib LoRa parts are supported:
        SX126x (sub-GHz), SX127x/RFM9x (sub-GHz), SX128x (2.4 GHz), and the
        LR11x0 / LR2021 families. The driver dispatches begin() per family;
        the runtime path is shared. SX128x needs 2.4 GHz freq/bandwidth
        values (the LoRa settings expose them).
    config LORA0_RADIO_SX1261
        bool "SX1261 (SX126x, sub-GHz)"
    config LORA0_RADIO_SX1262
        bool "SX1262 (SX126x, sub-GHz)"
    config LORA0_RADIO_SX1268
        bool "SX1268 (SX126x, sub-GHz)"
    config LORA0_RADIO_LLCC68
        bool "LLCC68 (SX126x, sub-GHz)"
    config LORA0_RADIO_SX1272
        bool "SX1272 (SX127x / RFM9x)"
    config LORA0_RADIO_SX1276
        bool "SX1276 (SX127x / RFM95)"
    config LORA0_RADIO_SX1277
        bool "SX1277 (SX127x / RFM97)"
    config LORA0_RADIO_SX1278
        bool "SX1278 (SX127x / RFM96/98)"
    config LORA0_RADIO_SX1280
        bool "SX1280 (SX128x, 2.4 GHz)"
    config LORA0_RADIO_SX1281
        bool "SX1281 (SX128x, 2.4 GHz)"
    config LORA0_RADIO_SX1282
        bool "SX1282 (SX128x, 2.4 GHz)"
    config LORA0_RADIO_LR1110
        bool "LR1110 (LR11x0)"
    config LORA0_RADIO_LR1120
        bool "LR1120 (LR11x0)"
    config LORA0_RADIO_LR1121
        bool "LR1121 (LR11x0)"
    config LORA0_RADIO_LR2021
        bool "LR2021"
endchoice
config LORA0_CHIP_ID
    int
    depends on LORA_COUNT > 0
    default 0 if LORA0_RADIO_SX1261
    default 1 if LORA0_RADIO_SX1262
    default 2 if LORA0_RADIO_SX1268
    default 3 if LORA0_RADIO_LLCC68
    default 4 if LORA0_RADIO_SX1272
    default 5 if LORA0_RADIO_SX1276
    default 6 if LORA0_RADIO_SX1277
    default 7 if LORA0_RADIO_SX1278
